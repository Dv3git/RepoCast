# RepoCast: variables de entorno
# Copia este fichero como .env.local y rellena los valores.
# .env.local está en .gitignore: tus claves nunca se suben a GitHub.

# Claude: analiza el código y escribe el guion del podcast
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini: las dos voces del podcast (texto a voz)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub: leer repositorios públicos sin chocar con el límite de 60 peticiones/hora
# https://github.com/settings/personal-access-tokens (token "fine-grained", solo lectura de repos públicos)
GITHUB_TOKEN=

# Supabase: usuarios (email y contraseña), base de datos y almacenamiento de los audios
# Panel del proyecto → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Conexión directa a Postgres (solo para crear las tablas con npm run db:migrate)
# Panel de Supabase → Connect → Session pooler
SUPABASE_DB_URL=

# Modelo de Claude: por defecto claude-haiku-5-5 (~0,01 $ por repositorio).
# Más calidad y coste: claude-sonnet-5-5 (~0,22 $) o claude-opus-5-5 (~0,45 $)
CLAUDE_MODEL=
